# Get your API key at https://www.eia.gov/opendata/
EIA_API_KEY=YOUR_EIA_API_KEY_HERE

# Server port (default: 3000)
PORT=3000


# Log level: debug | info | warn | error (default: info)
LOG_LEVEL=info

# Model Context Protocol endpoint at /mcp (off by default)
MCP_ENABLED=false

# Minimum spacing between outbound EIA API calls in ms; 0 disables (default: 5000)
EIA_MIN_INTERVAL_MS=5000
